{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gs2c/candidate.schema.json",
  "title": "Candidate record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "title", "source_url", "source_identity", "development_identifiers", "state", "created_at_utc"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "candidate_id": {"type": "string", "pattern": "^cand_[0-9a-f]{32}$"},
    "title": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "format": "uri"},
    "normalized_url": {"type": ["string", "null"], "format": "uri"},
    "source_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "development_identifiers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "state": {"enum": ["DISCOVERED", "EVIDENCE_PRESERVED", "NORMALIZED", "DUPLICATE_CHECKED", "QUALIFIED", "PACKET_GENERATED", "AWAITING_APPROVAL", "APPROVED", "RELEASED", "SUPPRESSED", "REJECTED", "FAILED"]},
    "created_at_utc": {"type": "string", "format": "date-time"}
  }
}
