{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gs2c/classification.schema.json",
  "title": "Classification proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "documented_facts", "reasonable_inferences", "direct_similarities", "broader_industry_trends", "primary_sources", "structural_overlap_dimensions", "qualification_decision", "qualification_reason"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "documented_facts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "reasonable_inferences": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "direct_similarities": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "broader_industry_trends": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "primary_sources": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uri"}, "uniqueItems": true},
    "structural_overlap_dimensions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "qualification_decision": {"type": "boolean"},
    "qualification_reason": {"type": "string", "minLength": 1}
  }
}
